# ============================================================
# AI Financial Coach — Environment Variables
# ============================================================

# Application
APP_ENV=development
PORT=8080
CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/financial_coach

# LLM Provider (mock | openai | compatible)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.7

# JWT
JWT_SECRET=change-this-in-production

# Vector DB (optional, for RAG)
VECTOR_DB_URL=

# Logging
LOG_LEVEL=info
